              SQLTask:SqlStatementSource="insert into DWH.fact_crime (junk_detail_key,victim_factor_key,date_key,time_key,location_key,&#xA;category_key,Response_Time_Min,Property_Loss_EGP,Officer_Count,Victim_Age,Suspect_Age)&#xA;select&#xA;djd.id as junk_detail_key,&#xA;df.Id as victom_factor_id,&#xA;dd.Date_Key as date_key,&#xA;dt.Time_Key as time_key,&#xA;dl.Id as location_key,&#xA;dc.Id as category_key,&#xA;Response_Time_Min,&#xA;Property_Loss_EGP,&#xA;Officer_Count,&#xA;Victim_Age,&#xA;Suspect_Age&#xA;from StagingArea.crime_core cc join StagingArea.case_details cd &#xA;on cc.Crime_ID=cd.Crime_ID&#xA;left join StagingArea.victim_factors vf&#xA;on cc.Crime_ID=vf.Crime_ID &#xA;left join DWH.dim_category dc &#xA;on cc.Crime_Category=dc.Crime_Category and cc.Crime_Type=dc.Crime_Type&#xA;left join DWH.dim_location dl &#xA;on  cc.Area=dl.Area and cc.District =dl.District and cc.Location_Type=dl.Location_Type &#xA;and cc.Neighborhood= dl.Neighborhood &#xA;left join DWH.Dim_Time dt &#xA;on cast(cc.Crime_Time as time)=dt.Time_Value&#xA;left join DWH.Dim_Date dd &#xA;on cast(cc.Crime_full_date as date)= cast(dd.Full_Date as date)&#xA;left join DWH.dim_factors df&#xA;on vf.Victim_Gender=df.Victim_Gender and vf.Suspect_Gender=df.Suspect_Gender and&#xA;vf.Repeat_Offender=df.Repeat_Offender and vf.Domestic_Related=df.Domestic_Related&#xA;left join DWH.dim_junk_detail djd &#xA;on cd.Weapon_Used=djd.Weapon_Used and cc.Reporting_Channel=djd.Reporting_Channel&#xA;and cd.Arrest_Made=djd.Arrest_Made and cd.Injury_Level=djd.Injury_Level &#xA;and cd.Priority_Level=djd.Priority_Level&#xA;where cast(cc.Crime_full_date as date)&gt;(select max(last_date) from incremental_table)&#xA;and cd.Officer_Count&gt;0 and cd.Response_Time_Min&gt;0 and cd.Property_Loss_EGP&gt;0 &#xA;and cd.Priority_Level in ('Low','High','Medium','Critical')&#xA;and vf.Victim_Age&gt;0 and vf.Suspect_Age&gt;0 and vf.Suspect_Gender in ('Female','Male')&#xA;and vf.Suspect_Gender in ('Female','Male');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\laod-bad-refernce-found"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0B27241B-7250-4F63-9B93-047DC7266373}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="laod-bad-refernce-found"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="insert into badData.InValidReferenceRows &#xA;(category_key,location_key,factors_key,junk_details_key,date_key,time_key,Response_Time_Min,Property_Loss_EGP,Officer_Count,Victim_Age,Suspect_Age)&#xA;select&#xA;dc.Id as category_key, &#xA;dl.Id as location_key , &#xA;df.Id as factors_key, &#xA;djd.id as junk_details_key,&#xA;date_key,&#xA;time_key,&#xA;Response_Time_Min,&#xA;Property_Loss_EGP,&#xA;Officer_Count,&#xA;Victim_Age,&#xA;Suspect_Age&#xA;from DWH.fact_crime fc&#xA;left join DWH.dim_category dc&#xA;on fc.category_key=dc.Id&#xA;left join DWH.dim_location dl &#xA;on fc.location_key=dl.Id&#xA;left join DWH.dim_factors df&#xA;on fc.victim_factor_key=df.Id&#xA;left join DWH.dim_junk_detail djd &#xA;on fc.junk_detail_key=djd.id&#xA;where dc.Id is null or dl.Id is null or df.Id is null or djd.id is null&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\Referential Integrity"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2FEB68F8-134A-4107-AF79-3D3FFE55DE24}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Referential Integrity"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="SELECT COUNT(*) AS total_undefined&#xA;FROM DWH.fact_crime fc&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM DWH.dim_category dc&#xA;    WHERE dc.Id = fc.category_key&#xA;)&#xA;OR NOT EXISTS (&#xA;    SELECT 1 FROM DWH.dim_location dl&#xA;    WHERE dl.Id = fc.location_key&#xA;)&#xA;OR NOT EXISTS (&#xA;    SELECT 1 FROM DWH.dim_factors df&#xA;    WHERE df.Id = fc.victim_factor_key&#xA;)&#xA;OR NOT EXISTS (&#xA;    SELECT 1 FROM DWH.dim_junk_detail djd&#xA;    WHERE djd.Id = fc.junk_detail_key&#xA;);"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="total_undefined"
                SQLTask:DtsVariableName="User::total_undefined" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\Source_Vs_Targe_For_Rows_Num"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{9631D148-8618-44BB-88F3-C898DBD1F6DC}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Source_Vs_Targe_For_Rows_Num"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="select (select count(*) from badData.rejectedRows)+(select count(*) from  DWH.fact_crime)&#xA;as total_destination,(select count(*) from[StagingArea].[case_details]) as total_source;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="total_destination"
                SQLTask:DtsVariableName="User::total_destination" />
              <SQLTask:ResultBinding
                SQLTask:ResultName="total_source"
                SQLTask:DtsVariableName="User::total_source" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\Update_Last_Bad_Record"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{44A64389-D1CD-48FC-94F4-46E3A999ECCC}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Update_Last_Bad_Record"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="UPDATE incremental_table&#xA;SET last_bad_record = (&#xA;    SELECT MAX(full_date)&#xA;    FROM badData.rejectedRows&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\Update_last_Good_Record"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{FCA887A9-6351-4B52-BF74-32A3BCCC1F1D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Update_last_Good_Record"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="UPDATE incremental_table&#xA;SET last_date = (&#xA;    SELECT MAX(dd.Full_Date)&#xA;    FROM DWH.fact_crime dc&#xA;    JOIN DWH.Dim_Date dd &#xA;        ON dc.date_key = dd.Date_Key&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
