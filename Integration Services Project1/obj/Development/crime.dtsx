  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\fact_crimes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{81FC0BAC-B148-411B-BC41-DC26A9C15409}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="fact_crimes"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
          SQLTask:SqlStatementSource="&#xA;insert into DWH.fact_crime (junk_detail_key,victim_factor_key,date_key,time_key,location_key,&#xA;category_key,Response_Time_Min,Property_Loss_EGP,Officer_Count,Victim_Age,Suspect_Age)&#xA;select&#xA;djd.id as junk_detail_key,&#xA;df.Id as victom_factor_id,&#xA;dd.Date_Key as date_key,&#xA;dt.Time_Key as time_key,&#xA;dl.Id as location_key,&#xA;dc.Id as category_key,&#xA;Response_Time_Min,&#xA;Property_Loss_EGP,&#xA;Officer_Count,&#xA;Victim_Age,&#xA;Suspect_Age&#xA;from StagingArea.crime_core cc join StagingArea.case_details cd &#xA;on cc.Crime_ID=cd.Crime_ID&#xA;join StagingArea.victim_factors vf&#xA;on cc.Crime_ID=vf.Crime_ID &#xA;join DWH.dim_category dc &#xA;on cc.Crime_Category=dc.Crime_Category and cc.Crime_Type=dc.Crime_Type&#xA;join DWH.dim_location dl &#xA;on  cc.Area=dl.Area and cc.District =dl.District and cc.Location_Type=dl.Location_Type &#xA;and cc.Neighborhood= dl.Neighborhood &#xA;join DWH.Dim_Time dt &#xA;on cast(cc.Crime_Time as time)=dt.Time_Value&#xA;join DWH.Dim_Date dd &#xA;on cast(cc.Crime_full_date as date)= cast(dd.Full_Date as date)&#xA;join DWH.dim_factors df&#xA;on vf.Victim_Gender=df.Victim_Gender and vf.Suspect_Gender=df.Suspect_Gender and&#xA;vf.Repeat_Offender=df.Repeat_Offender and vf.Domestic_Related=df.Domestic_Related&#xA;join DWH.dim_junk_detail djd &#xA;on cd.Weapon_Used=djd.Weapon_Used and cc.Reporting_Channel=djd.Reporting_Channel&#xA;and cd.Arrest_Made=djd.Arrest_Made and cd.Injury_Level=djd.Injury_Level &#xA;and cd.Priority_Level=djd.Priority_Level&#xA;where cast(cc.Crime_full_date as date)&gt;(select max(last_date) from incremental_table);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\getMaxDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{01802A3D-5EC5-497E-9D31-63FCB1F25048}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="getMaxDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
          SQLTask:SqlStatementSource="select coalesce(max(last_date),'1999','1','1')as last_date from incremental_table"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="last_date"
            SQLTask:DtsVariableName="User::last_date" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LoadingDimensionsToDWH"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{51CC724D-6378-4ECB-9362-4BBC04C6CEFC}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="LoadingDimensionsToDWH">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\LoadingDimensionsToDWH\dim_category"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{9BA0A8BD-77FB-489F-A32C-4C953D1225C9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="dim_category"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="with rnk as(&#xA;&#x9;select ROW_NUMBER() over(partition by Crime_Category,Crime_Type order by Crime_Time) as rnk_row,Crime_ID,Crime_Category,Crime_Type from StagingArea.crime_core&#xA;), filtered_rnk as (&#xA;&#x9;select Crime_ID,Crime_Category,Crime_Type &#xA;&#x9;from rnk &#xA;&#x9;where rnk_row=1&#xA;)&#xA;    merge into DWH.dim_category dest &#xA;&#x9;using filtered_rnk as source&#xA;&#x9;on &#xA;&#x9;dest.Crime_Category=source.Crime_Category and&#xA;&#x9;dest.Crime_Type=source.Crime_Type &#xA;&#x9;&#xA;&#x9;when not matched then&#xA;&#x9;&#x9;insert (Crime_ID,Crime_Category,Crime_Type)&#xA;&#x9;&#x9;values (source.Crime_ID,source.Crime_Category,source.Crime_Type);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingDimensionsToDWH\dim_crime_factors"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C4061ABF-4C9A-4FE3-85BC-8FB1C6E30ACD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="dim_crime_factors"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="1">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="with rnk as(&#xA;&#x9;select ROW_NUMBER() over(partition by Victim_Gender,Suspect_Gender,Repeat_Offender,Domestic_Related order by Victim_Age) as rnk_row,&#xA;&#x9;Crime_ID,Victim_Gender,Suspect_Gender,Repeat_Offender,Domestic_Related&#xA;&#x9;from StagingArea.victim_factors&#xA;), filtered_rnk as (&#xA;&#x9;select Crime_ID,Victim_Gender,Suspect_Gender,Repeat_Offender,Domestic_Related&#xA;&#x9;from rnk &#xA;&#x9;where rnk_row=1&#xA;)&#xA;&#x9;merge into DWH.dim_factors dest &#xA;&#x9;using filtered_rnk as source&#xA;&#x9;on &#xA;&#x9;dest.Victim_Gender=source.Victim_Gender and&#xA;&#x9;dest.Suspect_Gender=source.Suspect_Gender and&#xA;&#x9;dest.Repeat_Offender=source.Repeat_Offender and&#xA;&#x9;dest.Domestic_Related=source.Domestic_Related&#xA;&#x9;when not matched then&#xA;&#x9;&#x9;insert (Crime_ID,Victim_Gender,Suspect_Gender,Repeat_Offender,Domestic_Related)&#xA;&#x9;&#x9;values (source.Crime_ID,source.Victim_Gender,source.Suspect_Gender,source.Repeat_Offender,source.Domestic_Related)&#xA;&#x9;&#x9;;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingDimensionsToDWH\dim_junk_detail"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{899897C6-47EA-4E68-AD69-44FA64CD497E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="dim_junk_detail"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="2">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="&#xA;with rnk as(&#xA;&#x9;select ROW_NUMBER() over(partition by Weapon_Used,Arrest_Made,Injury_Level,Priority_Level  order by Officer_Count) as rnk_row,&#xA;&#x9;Crime_ID,Weapon_Used,Arrest_Made,Injury_Level,Priority_Level&#xA;&#x9;from StagingArea.case_details&#xA;), filtered_rnk as (&#xA;&#x9;select Crime_ID,Weapon_Used,Arrest_Made,Injury_Level,Priority_Level&#xA;&#x9;from rnk &#xA;&#x9;where rnk_row=1&#xA;)&#xA;,rnk_channel as(&#xA;&#x9;select ROW_NUMBER() over(partition by Reporting_Channel order by Crime_Time ) as rnk_channel,Reporting_Channel&#xA;&#x9;from StagingArea.crime_core&#xA;&#xA;), filtered_rnk_channel as (&#xA;&#x9;select Reporting_Channel from rnk_channel &#xA;&#x9;where rnk_channel=1&#xA;)&#xA;, cartesian_product as(&#xA;&#x9;select Weapon_Used,Arrest_Made,Priority_Level,Injury_Level,Reporting_Channel from&#xA;&#x9;filtered_rnk &#xA;&#x9;cross join &#xA;&#x9;filtered_rnk_channel&#xA;)&#xA;&#x9;merge into DWH.dim_junk_detail dest &#xA;&#x9;using cartesian_product as source&#xA;&#x9;on &#xA;&#x9;dest.Weapon_Used=source.Weapon_Used and&#xA;&#x9;dest.Arrest_Made=source.Arrest_Made and&#xA;&#x9;dest.Priority_Level=source.Priority_Level &#xA;&#x9;when not matched then&#xA;&#x9;&#x9;insert (Weapon_Used,Arrest_Made,Injury_Level,Priority_Level,Reporting_Channel)&#xA;&#x9;&#x9;values (source.Weapon_Used,source.Arrest_Made,source.Injury_Level,source.Priority_Level,source.Reporting_Channel)&#xA;&#x9;&#x9;;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingDimensionsToDWH\dim_location"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AE662BBB-9917-4787-99BE-3F5C702953BE}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="dim_location"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="with rnk as(&#xA;&#x9;select ROW_NUMBER() over(partition by Area,District,Neighborhood,Location_Type order by Crime_Time) as rnk_row,Crime_ID,Area,District,Location_Type,Neighborhood&#xA;&#x9;from StagingArea.crime_core&#xA;), filtered_rnk as (&#xA;&#x9;select Crime_ID,Area,District,Neighborhood,Location_Type&#xA;&#x9;from rnk &#xA;&#x9;where rnk_row=1&#xA;)&#xA;&#x9;merge into DWH.dim_location dest &#xA;&#x9;using filtered_rnk as source&#xA;&#x9;on &#xA;&#x9;dest.Area=source.Area and&#xA;&#x9;dest.District=source.District and&#xA;&#x9;dest.Location_Type=source.Location_Type and&#xA;&#x9;dest.Neighborhood=source.Neighborhood&#xA;&#x9;when not matched then&#xA;&#x9;&#x9;insert (Crime_ID,Area,District,Location_Type,Neighborhood)&#xA;&#x9;&#x9;values (source.Crime_ID,source.Area,source.District,source.Location_Type,source.Neighborhood)&#xA;&#x9;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
