      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\BadData_QualtiyChecks"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EA0B5B7A-590B-49C1-9901-E69DF9AE0B41}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="BadData_QualtiyChecks"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B02B03D-2711-4016-B562-4908BDE82260}"
              SQLTask:SqlStatementSource="insert into badData.rejectedRows &#xA;(full_date,&#xA;Officer_Count,&#xA;Response_Time_Min,&#xA;Property_Loss_EGP,&#xA;Priority_Level,&#xA;Victim_Age,&#xA;Suspect_Age,&#xA;Suspect_Gender,&#xA;Victim_Gender,&#xA;description&#xA;)&#xA;select &#xA;cc.Crime_full_date,&#xA;Officer_Count,&#xA;Response_Time_Min,&#xA;Property_Loss_EGP,&#xA;Priority_Level,&#xA;vf.Victim_Age,&#xA;vf.Suspect_Age,&#xA;vf.Suspect_Gender,&#xA;vf.Victim_Gender,&#xA;case &#xA;when &#xA;&#x9;Officer_Count &lt; 0 then 'negative Officer count'&#xA;when &#xA;&#x9;Response_Time_Min &lt; 0 then 'negative Response_Time_Min'&#xA;when &#xA;&#x9;Property_Loss_EGP &lt; 0 then 'negative Property_Loss_EGP' &#xA;when &#xA;&#x9;Priority_Level &lt;&gt; 'Low' and Priority_Level &lt;&gt; 'High' and Priority_Level &lt;&gt; 'Medium' and Priority_Level &lt;&gt; 'Critical' &#xA;then 'Invalid value of Priority level' &#xA;when &#xA;&#x9;Property_Loss_EGP &lt; 0 then 'negative Property_Loss_EGP' &#xA;when vf.Victim_Age&lt;=0 then 'invalid victim age'&#xA;when vf.Suspect_Age&lt;=0 then 'invalid suspect age'&#xA;when vf.Suspect_Gender &lt;&gt;'Female' and vf.Suspect_Gender &lt;&gt;'Male' then 'invalid type of Suspect_Gender'&#xA;when vf.Victim_Gender &lt;&gt;'Female' and vf.Suspect_Gender &lt;&gt;'Male' then 'invalid type of Victim_Gender'&#xA;end as description&#xA;from [StagingArea].[case_details] cd join [StagingArea].[victim_factors] vf&#xA;on cd.Crime_ID=vf.Crime_ID &#xA;join [StagingArea].[crime_core] cc&#xA;on cc.Crime_ID=vf.Crime_ID &#xA;where &#xA;cast(cc.Crime_full_date as date)&gt;(select max(last_bad_record) from incremental_table)&#xA;and(&#xA;cd.Officer_Count&lt;=0 or cd.Response_Time_Min&lt;=0 or cd.Property_Loss_EGP&lt;=0 &#xA;or cd.Priority_Level not in ('Low','High','Medium','Critical')&#xA;or vf.Victim_Age&lt;=0 or vf.Suspect_Age&lt;=0 or vf.Suspect_Gender not in ('Female','Male')&#xA;or vf.Suspect_Gender not in ('Female','Male')&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\LoadingToFactTable\checking rows number"
          DTS:CreationName="Microsoft.ScriptTask"
          DTS:Description="Script Task"
